# Local development: replace both values with unique random secrets.
ADMIN_KEY=replace-with-a-long-random-secret-at-least-24-characters
SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Leave unset for local JSON storage. Set to a real Neon PostgreSQL connection string for production.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: comma-separated allowed browser origins for cross-origin use.
# APP_ORIGIN=https://your-production-domain.vercel.app

NODE_ENV=development
