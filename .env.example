# ==============================================================================
# TOP-X Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Do NOT commit .env.local or any production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Persistence (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Connection string for Neon PostgreSQL database.
# Required in all environments. The app will return an error if PostgreSQL is unavailable.
# Example: postgresql://user:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/topx?sslmode=require
DATABASE_URL=

# Optional pg driver pool tuning for non-Neon PostgreSQL connections.
PG_POOL_MAX=8
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 2. Security Keys
# ------------------------------------------------------------------------------
# Secret key used for authenticating admin routes (/api/admin/*) and signing admin sessions.
# In production, must be at least 24 characters.
ADMIN_KEY=local-dev-admin-key-that-is-long-enough-123456

# Secret key used for HMAC-SHA256 signing of user authentication session tokens.
# In production, must be at least 32 characters.
SESSION_SECRET=local-dev-session-secret-that-is-long-enough-123456789

# Secret used to authorize the scheduled daily leaderboard refresh.
# Set the same long, random value in Vercel's production environment variables.
CRON_SECRET=

# ------------------------------------------------------------------------------
# 3. Google Sign-In & OAuth Configuration
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client credentials obtained from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Web Application).
# 2. Add Authorized JavaScript origins: http://localhost:3000 (and production URL).
# 3. Add Authorized redirect URIs: http://localhost:3000/api/auth/google/callback.
# 4. Copy the Client ID and Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. Firebase Authentication Web SDK Configuration
# ------------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app:
# https://console.firebase.google.com/
# Enable Authentication -> Sign-in method -> Google Provider
# Add Authorized domains: localhost, 127.0.0.1, and production domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 5. Application Runtime & Networking
# ------------------------------------------------------------------------------
# Application environment mode ('development', 'production', or 'test')
NODE_ENV=development

# Optional: Port for Next.js server (defaults to 3000)
PORT=3000

# Optional: Allowed CORS origin(s) for API Route Handlers.
# Comma-separated list of origins (e.g., http://localhost:3000,https://my-domain.com).
# If left blank, defaults to permissive origin reflection.
APP_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Note on Competitive Programming APIs:
# ------------------------------------------------------------------------------
# External sync endpoints for Codeforces, LeetCode, and CodeChef use public
# web APIs and do NOT require any third-party API keys or credentials.
