# ==============================================================================
# TOP-X Admin Panel — Environment Variables
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# Do NOT commit .env.local or any production secrets to source control.
# ==============================================================================

# Base URL of the main TOP-X application API.
# In local development, this is the Next.js dev server (default port 3000).
# In production, this is the deployed URL of the main TOP-X application.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Application environment
NODE_ENV=development

# Optional: Admin panel port (defaults to 3001)
PORT=4000
ADMIN_KEY=TX99_k8F7#mP2$xQ9vL4!eR6*wT1@bN5^yU3&jZ8_ADMIN_MASTER
